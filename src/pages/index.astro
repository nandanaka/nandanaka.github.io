---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Nandana K A">
  <header class="site-header">
    <h1 class="name">Nandana K A</h1>
    <p class="tagline">Software Development Engineer — backend systems &amp; ML for financial data.</p>
    <p class="contact-line">
      <a href="mailto:nandanaka10@gmail.com">nandanaka10@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/nandanaka">LinkedIn</a> ·
      <a href="https://github.com/nandanaka">GitHub</a> ·
      <a href="/resume.pdf">Resume (PDF)</a>
    </p>
  </header>

  <section>
    <p>
      Software engineer with 2+ years building scalable backend systems and ML-driven pipelines
      for large-scale financial data processing. I work across Python and R, ship production
      services that handle <strong>30K+ bank statements per day</strong>, and have measurable
      gains in matching accuracy, latency, and fraud detection. Recent work involves NLP, LLM
      integration on Vertex AI / Gemini, and cloud-native deployments.
    </p>
  </section>

  {projects.length > 0 && (
    <section>
      <h2>Selected Work</h2>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={`/projects/${project.id}/`}>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2>Experience</h2>

    <div class="entry">
      <div class="entry-header">
        <span class="role">Software Development Engineer</span>
        <span class="date">August 2023 – Present</span>
      </div>
      <div class="entry-sub">
        <span>Perfios Software Solutions</span>
        <span>Bangalore, India</span>
      </div>
      <ul>
        <li>
          Designed and developed scalable backend systems for financial data processing,
          including fuzzy name matching and de-duplication, <strong>improving match
          accuracy by 47%</strong> and <strong>reducing false positives by 25%</strong>.
        </li>
        <li>
          Optimized the matching pipeline to <strong>cut latency and memory usage by 50%</strong>,
          enabling higher throughput on the same infrastructure.
        </li>
        <li>
          Built and maintained RESTful APIs in Flask with Celery for asynchronous task
          processing and PostgreSQL-backed schemas, reliably processing
          <strong>30K+ bank statements per day</strong>.
        </li>
        <li>
          Designed and deployed an on-prem backend API for fuzzy name matching using
          R Plumber, achieving <strong>sub-200ms response times</strong> through
          asynchronous execution with mirai, and enabling reproducible client deployments
          via Docker.
        </li>
        <li>
          Partnered with customers, sales, product, and QA to understand Malaysian naming
          patterns, and improved fuzzy matching by implementing a BiLSTM-based
          person/entity classifier with token alignment, achieving a
          <strong>22% accuracy increase</strong>.
        </li>
        <li>
          Built and optimized fraud detection engines analyzing large-scale bank
          transaction data using Polars and Pandas, integrating spend-category and
          transaction-mode intelligence for a <strong>28% improvement in detection
          accuracy</strong>.
        </li>
        <li>
          Developed a document Q&amp;A chatbot on Vertex AI (Gemini) for insurance
          reports, enabling underwriters to ask natural-language questions and receive
          precise, context-driven answers through prompt engineering.
        </li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Publications</h2>
    <div class="entry">
      <div class="entry-header">
        <span class="role">
          <a href="https://ieeexplore.ieee.org/document/10170132">
            Human Activity Recognition for Office Surveillance
          </a>
          — IEEE INCET 2023
        </span>
        <span class="date">May 2023</span>
      </div>
      <ul>
        <li>
          Designed a deep-learning pipeline (ConvLSTM, GRCNN, LRCN) for activity
          recognition on real-world office surveillance video, covering preprocessing,
          feature extraction, and classification.
        </li>
        <li>
          Achieved <strong>86.17% test accuracy</strong> with LRCN, outperforming the
          ConvLSTM and GRCNN baselines on robustness and generalization.
        </li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Technical Skills</h2>
    <ul class="skills-list">
      <li><span class="label">Languages:</span> Python, R, SQL (PostgreSQL), Java, C/C++, HTML/CSS</li>
      <li><span class="label">Frameworks / Backend:</span> Flask, Celery, R Plumber, FastAPI, mirai, RESTful APIs</li>
      <li><span class="label">Data &amp; AI:</span> Polars, Pandas, NumPy, Vertex AI (Gemini), LLMs, Prompt Engineering, BiLSTM, NLP, Vector DB</li>
      <li><span class="label">Developer Tools:</span> Docker, Git, Google Cloud Platform (GCP), VS Code, PyCharm, IntelliJ</li>
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    <div class="entry">
      <div class="entry-header">
        <span class="role">PES University</span>
        <span class="date">August 2019 – June 2023</span>
      </div>
      <div class="entry-sub">
        <span>B.Tech, Computer Science — CGPA 8.4 / 10.0</span>
        <span>Bangalore, India</span>
      </div>
    </div>
  </section>

  <footer>
    <p>
      <a href="mailto:nandanaka10@gmail.com">nandanaka10@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/nandanaka">LinkedIn</a> ·
      <a href="https://github.com/nandanaka">GitHub</a>
    </p>
  </footer>
</BaseLayout>
